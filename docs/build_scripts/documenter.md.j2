{% extends 'markdown/index.md.j2' %}

{% block markdowncell scoped %}
{{ cell.source | documenter_markdown }}
{% endblock markdowncell %}

{% block data_png %}
```@raw html
<a href="{{ output.metadata.filenames['image/png'] | path2url | e }}"><img src="{{ output.metadata.filenames['image/png'] | path2url | e }}" alt="{{ output.metadata.figure_alt | figure_alt }}"></a>
```
{% endblock data_png %}

{% block data_svg %}
```@raw html
<a href="{{ output.metadata.filenames['image/svg+xml'] | path2url | e }}"><img src="{{ output.metadata.filenames['image/svg+xml'] | path2url | e }}" alt="{{ output.metadata.figure_alt | figure_alt }}"></a>
```
{% endblock data_svg %}
